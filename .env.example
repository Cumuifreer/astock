# 免费日线；本地历史数据与策略保存在 DuckDB。
ASHARE_HISTORY_DAYS=550
ASHARE_ANALYSIS_BATCH_SIZE=200
ASHARE_DB_MEMORY_LIMIT=512MB
ASHARE_DB_THREADS=2
ASHARE_BAOSTOCK_SOCKET_TIMEOUT=30
ASHARE_BAOSTOCK_MAX_CONSECUTIVE_FAILURES=8

# 单进程部署。定时器按北京时间运行；关闭时仍可手动更新。
ASHARE_DAILY_UPDATE_SCHEDULER=1
ASHARE_DAILY_UPDATE_TIME=18:30

# 公网访问认证；两项同时设置生效。
ASHARE_HTTP_BASIC_USERNAME=
ASHARE_HTTP_BASIC_PASSWORD=
