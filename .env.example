# 默认是无需密钥的免费模式；关闭时不会读取对应密钥环境变量。
ASHARE_LLM_ENABLED=0
ASHARE_TUSHARE_ENABLED=0

# 内置 scheduler 是唯一推荐的盘中调度器。
ASHARE_INTRADAY_SCHEDULER=1
ASHARE_INTRADAY_SCHEDULE=09:40,10:10,10:40,11:10,13:10,13:40,14:10,14:40,14:55
ASHARE_INTRADAY_RETENTION_DAYS=10
ASHARE_BAOSTOCK_SOCKET_TIMEOUT=30
ASHARE_BAOSTOCK_MAX_CONSECUTIVE_FAILURES=8
ASHARE_SINA_PAGE_MIN_DELAY=0.35
ASHARE_SINA_PAGE_MAX_DELAY=0.75
ASHARE_SINA_MIN_INTERVAL_MINUTES=12
ASHARE_SINA_FAILURE_COOLDOWN_MINUTES=180

# 公网部署建议启用；两项必须同时设置。
ASHARE_HTTP_BASIC_USERNAME=
ASHARE_HTTP_BASIC_PASSWORD=

# 以后确实要恢复付费/LLM 能力时再取消注释并显式打开总开关：
# ASHARE_LLM_ENABLED=1
# ASHARE_DAILY_BRIEF_API_KEY=replace-with-your-key
# ASHARE_DAILY_BRIEF_MODEL=deepseek-chat
# ASHARE_TUSHARE_ENABLED=1
# ASHARE_TUSHARE_TOKEN=replace-with-your-token
# ASHARE_TUSHARE_HTTP_URL=http://101.35.233.113:8020/
